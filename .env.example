PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080
STATIC_DIR=dist
COOKIE_DOMAIN=

DISCOVERY_CALL_URL=https://cal.com/your-handle/discovery-call

# Single global destination for every /r/lead-magnet click. The `asset` query
# param labels the capture but does NOT choose the form, so this is one lead
# magnet at a time. The form must have a hidden `jls_tracking` field and a Tally
# webhook on /webhooks/tally signed with TALLY_WEBHOOK_SECRET — without the
# hidden field, captures arrive with no attribution and look like organic
# traffic. Changing this is a deploy-time value: it is baked into the Cloud Run
# revision via --update-env-vars, so editing the GitHub secret alone changes
# nothing until the next deploy.
LEAD_MAGNET_URL=https://tally.so/r/your-form

TRACKING_SECRET=replace-me
INTERNAL_API_TOKEN=replace-me
CALCOM_WEBHOOK_SECRET=
TALLY_WEBHOOK_SECRET=

POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
HUBSPOT_TOKEN=
HUBSPOT_STAGE_EVENT_MAP_JSON={"appointmentscheduled":"discovery_completed","qualifiedtobuy":"qualified_lead_marked","presentationscheduled":"diagnostic_sold","contractsent":"sprint_sold","closedwon":"retainer_started"}

SERVICE_URL=
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
FIRESTORE_PROJECT_ID=
USE_MEMORY_STORE=true

# LinkedIn Publishing
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=urn:li:person:mvKbumetTz
